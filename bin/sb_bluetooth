#!/bin/sh

# Bluetooth block. Exits silently if there is no Bluetooth adapter.
#   left click    open bluetui
#   middle click  notification listing connected devices
#   right click   toggle Bluetooth on/off

# Bluetooth rfkill switches. These stay present while blocked (the adapter
# itself vanishes), so they decide whether this machine has Bluetooth at all.
switches=$(grep -lx bluetooth /sys/class/rfkill/rfkill*/type 2>/dev/null)
[ -z "$switches" ] && exit 0

adapter=$(ls /sys/class/bluetooth 2>/dev/null | grep -m1 '^hci[0-9]*$')
path="/org/bluez/${adapter:-hci0}"

# Blocked by rfkill (airplane mode)
blocked() {
    for t in $switches; do
        rf=${t%/type}
        [ "$(cat "$rf/soft" 2>/dev/null)" = 1 ] || [ "$(cat "$rf/hard" 2>/dev/null)" = 1 ] && return 0
    done
    return 1
}

powered() {
    [ "$(busctl get-property org.bluez "$path" org.bluez.Adapter1 Powered 2>/dev/null)" = "b true" ]
}

case "$BLOCK_BUTTON" in
    1)  st -t bluetui -g 96x29 -e bluetui
        ;;
    2)  devices=$(busctl call org.bluez / org.freedesktop.DBus.ObjectManager \
                GetManagedObjects --json=short 2>/dev/null \
            | jq -r '.data[0][] | .["org.bluez.Device1"] // empty
                     | select(.Connected.data) | .Alias.data')
        notify-send -r 16 -a scripts "Bluetooth" "${devices:-<i>No devices connected</i>}"
        ;;
    3)  if blocked || ! powered; then
            rfkill unblock bluetooth
            # The adapter takes a moment to reappear after an unblock
            for _ in 1 2 3 4 5; do
                adapter=$(ls /sys/class/bluetooth 2>/dev/null | grep -m1 '^hci[0-9]*$')
                path="/org/bluez/${adapter:-hci0}"
                busctl set-property org.bluez "$path" org.bluez.Adapter1 Powered b true 2>/dev/null && break
                sleep 0.5
            done
        else
            busctl set-property org.bluez "$path" org.bluez.Adapter1 Powered b false
        fi
        ;;
esac

if ! blocked && powered; then
    echo "^b#111111^^c#ddc7a1^󰂯 ^d^"
else
    echo "^b#111111^^c#ddc7a1^󰂲 ^d^"
fi
