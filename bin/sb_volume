#!/bin/sh

case "$BLOCK_BUTTON" in
    1)  st -t pulsemixer -g 96x29 -e pulsemixer
        kill -44 $(pidof dwmblocks)
        ;;
    2)  micmute
        ;;
    3)  pactl set-sink-mute @DEFAULT_SINK@ toggle
        ;;
    4)  pactl set-sink-volume @DEFAULT_SINK@ +5%
        ;;
    5)  pactl set-sink-volume @DEFAULT_SINK@ -5%
        ;;
esac

tries=0
while [ -z "$vol" ] && [ "$tries" -lt 10 ]; do
    vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -o '[0-9]\+%' | head -n1 | tr -d '%')
    [ -z "$vol" ] && sleep 0.5
    tries=$((tries + 1))
done
mute=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')
vol=${vol:-0}

# Mic-off icon in front of the volume, only while the mic is muted
mic=""
[ "$(pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null | awk '{print $2}')" = "yes" ] && mic="󰍭 "

if [ "$mute" = "yes" ] || [ "$vol" -eq 0 ]; then
    echo "^b#111111^^c#ddc7a1^$mic󰖁 muted^d^"
elif [ "$vol" -ge 70 ]; then
    echo "^b#111111^^c#ddc7a1^$mic󰕾 $vol%^d^"
elif [ "$vol" -ge 30 ]; then
    echo "^b#111111^^c#ddc7a1^$mic󰖀 $vol%^d^"
else
    echo "^b#111111^^c#ddc7a1^$mic󰕿 $vol%^d^"
fi
